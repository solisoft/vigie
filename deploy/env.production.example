# Production .env for sites/vigie.solisoft.net — fill in, never commit the real one.

APP_ENV=production
APP_URL=https://vigie.solisoft.net

# SoliDB on the server: a dedicated database and user for Vigie
SOLIDB_HOST=http://127.0.0.1:6745
SOLIDB_DATABASE=vigie
SOLIDB_USERNAME=vigie
SOLIDB_PASSWORD=

# Sessions survive restarts and both workers (32+ characters)
SOLI_SESSION_DRIVER=cookie
SOLI_SESSION_SECRET=

SOLI_CSRF_TOKENS=require

# Monitors may only probe public targets in production
# VIGIE_ALLOW_PRIVATE_TARGETS stays unset

# Raw checks kept 14 days, then only the daily rollups
VIGIE_RAW_RETENTION_DAYS=14

# /_metrics: set a token, the app sits behind the proxy
SOLI_METRICS=1
SOLI_METRICS_TOKEN=

SOLI_JOB_WORKERS=4
SOLI_JOBS_RETENTION_SECS=3600

# E-mail alerts (optional)
# SOLI_SMTP_HOST=
# SOLI_SMTP_PORT=587
# SOLI_SMTP_USERNAME=
# SOLI_SMTP_PASSWORD=
# SOLI_SMTP_FROM=vigie@solisoft.net
