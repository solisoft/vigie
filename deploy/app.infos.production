# How soli-proxy runs Vigie in production (copied to sites/vigie.solisoft.net/app.infos).
name = "vigie.solisoft.net"
domain = "vigie.solisoft.net"

start_script = "soli serve . --port $PORT --workers $WORKERS --strict-port"
workers = 2
stop_script = ""

health_check = "/health"
graceful_timeout = 30

port_range_start = 20000
port_range_end = 30000
