# Auth mailer — password reset + email confirmation. Generated by `soli generate auth`.
#
# Bodies render app/views/auth_mailer/<action>.html.slv. Configure delivery
# via SOLI_SMTP_* env vars or Mailer.configure({...}); set
# SOLI_MAIL_DELIVERY_METHOD=logger in dev to print emails to the console.
# Links are built from `auth_base_url` (app/models/user.sl).

class AuthMailer < Mailer
  def reset_password(user, token)
    @user = user
    @reset_url = auth_base_url() + "/password/edit?token=" + token
    this.mail(to: user.email, subject: "Vigie : réinitialiser le mot de passe")
  end

  def confirm_email(user, token)
    @user = user
    @confirm_url = auth_base_url() + "/confirm_email?token=" + token
    this.mail(to: user.email, subject: "Vigie : confirmez votre adresse")
  end

  # Sent once, when the lockout trips. The sign-in response deliberately says
  # nothing about the lock — telling the browser "this account is locked" also
  # tells whoever is guessing that they found the right password — so this is
  # how the owner finds out.
  def account_locked(user, lock_minutes)
    @user = user
    @lock_minutes = lock_minutes
    @reset_url = auth_base_url() + "/password/reset"
    this.mail(to: user.email, subject: "Vigie : compte temporairement verrouillé")
  end
end
