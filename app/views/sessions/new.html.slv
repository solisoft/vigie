<main class="gate">
  <div class="gate-card">
    <%- partial("shared/mark", {}) %>
    <h1>Connexion</h1>
    <p class="muted">Administration de Vigie</p>
    <% if error.present? %>
      <p class="error" role="alert"><%= error %></p>
    <% end %>
    <form action="/login" method="POST">
      <%- csrf_field() %>
      <div>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="username" value="<%= email %>">
      </div>
      <div>
        <label for="password">Mot de passe</label>
        <input id="password" name="password" type="password" required autocomplete="current-password">
      </div>
      <label class="check"><input type="checkbox" name="remember_me" value="1"> Rester connecté</label>
      <button type="submit">Se connecter</button>
    </form>
    <p class="links"><a href="/password/reset">Mot de passe oublié ?</a></p>
  </div>
</main>
