<main class="gate">
  <div class="gate-card">
    <%- partial("shared/mark", {}) %>
    <h1>Mot de passe oublié</h1>
    <% if notice.present? %><p class="muted" role="status"><%= notice %></p><% end %>
    <% if error.present? %><p class="error" role="alert"><%= error %></p><% end %>
    <form action="/password/reset" method="POST">
      <%- csrf_field() %>
      <div>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="username">
      </div>
      <button type="submit">Recevoir un lien</button>
    </form>
    <p class="links"><a href="/login">Retour à la connexion</a></p>
  </div>
</main>
