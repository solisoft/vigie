<main class="gate">
  <div class="gate-card">
    <%- partial("shared/mark", {}) %>
    <h1>Nouveau mot de passe</h1>
    <% if error.present? %><p class="error" role="alert"><%= error %></p><% end %>
    <form action="/password/update" method="POST">
      <%- csrf_field() %>
      <input type="hidden" name="token" value="<%= token %>">
      <div>
        <label for="password">Mot de passe</label>
        <input id="password" name="password" type="password" required autofocus minlength="12" autocomplete="new-password">
      </div>
      <div>
        <label for="password_confirmation">Confirmation</label>
        <input id="password_confirmation" name="password_confirmation" type="password" required minlength="12" autocomplete="new-password">
      </div>
      <button type="submit">Enregistrer</button>
    </form>
  </div>
</main>
