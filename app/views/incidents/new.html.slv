<header class="desk-head"><div><h1>Déclarer un incident</h1><p>Il apparaît sur les pages qui affichent les sondes choisies.</p></div></header>
<section class="panel"><div class="panel-body">
  <%- form_with(@incident, {"url": "/admin/incidents", "class": "form"}) do |f| -%>
    <%- f.error_summary() %>
    <div><%- f.label("title", "Titre") %><%- f.text_field("title", {"required": true, "placeholder": "Lenteurs sur l'API"}) %><%- f.errors_for("title") %></div>
    <div class="row">
      <div><%- f.label("status", "Statut") %><%- f.select("status", @statuses) %></div>
      <div><%- f.label("impact", "Impact") %><%- f.select("impact", @impacts) %></div>
    </div>
    <div><label for="message">Premier message</label><textarea id="message" name="message" placeholder="Nous analysons des lenteurs…"></textarea></div>
    <%- partial("shared/monitor_choices", {
      "choices": @monitor_choices,
      "selected": @incident.monitor_ids ?? [],
      "legend": "Services concernés",
      "hint": "L'incident s'affiche sur les services de la page publique qui utilisent ces sondes."
    }) %>
    <%- f.errors_for("monitor_ids") %>
    <div class="form-actions"><%- f.submit("Publier") %><a href="/admin/incidents">Annuler</a></div>
  <%- end -%>
</div></section>
