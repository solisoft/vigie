<header class="desk-head">
  <div><h1><%= title %></h1><p>Page <a href="/admin/pages/<%= @page._key %>"><%= @page.title %></a></p></div>
  <% remove_confirm = "Retirer ce service ? Les sondes qu'il est seul à utiliser partent avec leur historique." %>
  <% remove_options = {"method": "delete", "confirm": remove_confirm} %>
  <div class="actions">
    <span class="danger"><%- button_to("Retirer le service", "/admin/composants/#{@component._key}", remove_options) %></span>
  </div>
</header>

<section class="panel">
  <div class="panel-head"><h2>Sondes de ce service</h2><span class="faint">le service prend l'état de la pire d'entre elles</span></div>
  <% if @monitors.length == 0 %>
    <div class="panel-body"><p class="empty">Aucune sonde : ce service s'affiche « en attente » sur la page publique.</p></div>
  <% else %>
    <div class="table-wrap">
      <table class="ledger">
        <thead><tr><th scope="col">Sonde</th><th scope="col">Type</th><th scope="col">État</th><th scope="col"><span class="sr-only">Action</span></th></tr></thead>
        <tbody>
          <% for monitor in @monitors %>
            <tr>
              <td><a href="/admin/sondes/<%= monitor._key %>"><%= monitor.name %></a><span class="target"><%= monitor.target_label %></span></td>
              <td><%= monitor.kind_label %></td>
              <td><span class="chip s-<%= monitor.paused ? "paused" : monitor.status %>"><%- status_icon(monitor.paused ? "paused" : monitor.status) %><%= status_text(monitor.paused ? "paused" : monitor.status) %></span></td>
              <td class="ghost"><%- button_to("Détacher", "/admin/composants/#{@component._key}/sondes/#{monitor._key}", {"method": "delete"}) %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
  <div class="panel-body attach-row">
    <% if @attachable.length > 0 %>
      <form class="form attach-form" action="/admin/composants/<%= @component._key %>/sondes" method="POST">
        <%- csrf_field() %>
        <div>
          <label for="attach_monitor">Rattacher une sonde existante</label>
          <select id="attach_monitor" name="monitor_id" required>
            <option value="">Choisir une sonde…</option>
            <% for monitor in @attachable %>
              <option value="<%= monitor._key %>"><%= monitor.name %> — <%= monitor.kind_label %></option>
            <% end %>
          </select>
        </div>
        <div class="form-actions"><button type="submit">Rattacher</button></div>
      </form>
    <% end %>
    <p class="hint">Une tâche planifiée à surveiller ? <a href="/admin/sondes/nouvelle?kind=heartbeat&amp;composant=<%= @component._key %>">Créer un heartbeat pour ce service</a>.</p>
  </div>
</section>

<section class="panel">
  <div class="panel-head"><h2>Affichage</h2></div>
  <div class="panel-body">
    <%- form_with(@component, {"url": "/admin/composants/#{@component._key}", "class": "form"}) do |f| -%>
      <%- f.error_summary() %>
      <div class="row">
        <div><%- f.label("name", "Nom") %><%- f.text_field("name", {"required": true}) %><%- f.errors_for("name") %></div>
        <div><%- f.label("group_name", "Groupe") %><%- f.text_field("group_name") %></div>
        <div><%- f.label("position", "Ordre") %><%- f.number_field("position") %></div>
      </div>
      <div><%- f.label("description", "Description") %><%- f.text_field("description") %></div>
      <div class="form-actions"><%- f.submit("Enregistrer") %><a href="/admin/pages/<%= @page._key %>">Annuler</a></div>
    <%- end -%>
  </div>
</section>
