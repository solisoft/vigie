<header class="desk-head">
  <div><h1><%= title %></h1></div>
  <% delete_options = {"method": "delete", "confirm": "Supprimer cette maintenance ?"} %>
  <div class="actions">
    <span class="danger"><%- button_to("Supprimer", "/admin/maintenances/#{@maintenance._key}", delete_options) %></span>
  </div>
</header>
<section class="panel"><div class="panel-body">
  <% form_url = "/admin/maintenances/#{@maintenance._key}" %>
  <% form_locals = {"maintenance": @maintenance, "url": form_url, "choices": @monitor_choices} %>
  <%- partial("maintenances/form", form_locals.merge({"starts_local": @starts_local, "ends_local": @ends_local})) %>
</div></section>
