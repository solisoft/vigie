<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> · Vigie</title>
  <% share_description = description ?? "Page de statut et surveillance de disponibilité." %>
  <% share_url = absolute_url(req ? req["path"] : "/") %>
  <meta name="description" content="<%= share_description %>">
  <link rel="canonical" href="<%= share_url %>">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Vigie">
  <meta property="og:title" content="<%= title %> · Vigie">
  <meta property="og:description" content="<%= share_description %>">
  <meta property="og:url" content="<%= share_url %>">
  <meta property="og:image" content="<%= absolute_url(og_image ?? "/images/og.png") %>">
  <meta name="twitter:card" content="summary_large_image">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="<%= public_path("css/vigie.css") %>">
</head>
<body>
  <%= yield %>
</body>
</html>
