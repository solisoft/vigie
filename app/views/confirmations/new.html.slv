<main class="gate">
  <div class="gate-card">
    <%- partial("shared/mark", {}) %>
    <h1>Confirmer l'adresse</h1>
    <% if notice.present? %><p class="muted" role="status"><%= notice %></p><% end %>
    <% if error.present? %><p class="error" role="alert"><%= error %></p><% end %>
    <form action="/confirmation/resend" method="POST">
      <%- csrf_field() %>
      <div>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="username">
      </div>
      <button type="submit">Renvoyer le lien</button>
    </form>
  </div>
</main>
