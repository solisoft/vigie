<main class="gate">
  <div class="gate-card">
    <%- partial("shared/mark", {}) %>
    <h1>Premier compte</h1>
    <p class="muted">Ce compte administrera Vigie. Les inscriptions se ferment ensuite.</p>
    <% if error.present? %>
      <p class="error" role="alert"><%= error %></p>
    <% end %>
    <form action="/signup" method="POST">
      <%- csrf_field() %>
      <div>
        <label for="email">E-mail</label>
        <input id="email" name="email" type="email" required autofocus autocomplete="username" value="<%= user.email.to_s %>">
      </div>
      <div>
        <label for="password">Mot de passe</label>
        <input id="password" name="password" type="password" required minlength="12" autocomplete="new-password">
        <p class="faint">12 caractères au moins. Une phrase de quelques mots se retient mieux.</p>
      </div>
      <button type="submit">Créer le compte</button>
    </form>
    <p class="links"><a href="/login">J'ai déjà un compte</a></p>
  </div>
</main>
