# Vigie — routes.
#
# Public: the status pages and what hangs off them (live updates, Atom feed,
# JSON API, badges), the heartbeat endpoint. Admin: everything under /admin,
# behind the `require_login` middleware.

get("/", "home#index")
get("/health", "home#health")

# Public status pages
get("/s/:slug", "status_pages#show", name: "status_page")
get("/s/:slug/live", "status_pages#live", name: "status_page_live")
get("/s/:slug/incidents.atom", "status_pages#feed", name: "status_page_feed")
get("/s/:slug/incidents/:id", "status_pages#incident", name: "status_page_incident")
get("/api/v1/status", "api#status", name: "api_status")
get("/badge/:file", "badges#show", name: "badge")

# Heartbeat monitors: a cron job calls its secret URL
get("/ping/:token", "heartbeats#ping", name: "ping")
post("/ping/:token", "heartbeats#ping")
skip_csrf("/ping/*")

# Authentication routes (generated by `soli generate auth`)
get("/login", "sessions#new", name: "login")
post("/login", "sessions#create")
delete("/logout", "sessions#destroy", name: "logout")
get("/signup", "registrations#new", name: "signup")
post("/signup", "registrations#create")

# Password reset + email confirmation (generated by `soli generate auth`)
get("/password/reset", "passwords#new", name: "password_reset")
post("/password/reset", "passwords#create")
get("/password/edit", "passwords#edit", name: "password_edit")
post("/password/update", "passwords#update")
get("/confirm_email", "confirmations#show", name: "confirm_email")
get("/confirmation/resend", "confirmations#new", name: "confirmation_resend")
post("/confirmation/resend", "confirmations#create")

# Admin
middleware("require_login", fn() {
  get("/admin", "dashboard#show", name: "dashboard")
  get("/admin/live", "dashboard#live", name: "dashboard_live")

  get("/admin/sondes", "monitors#index", name: "monitors")
  get("/admin/sondes/nouvelle", "monitors#new", name: "new_monitor")
  post("/admin/sondes", "monitors#create")
  get("/admin/sondes/:id", "monitors#show", name: "monitor")
  get("/admin/sondes/:id/modifier", "monitors#edit", name: "edit_monitor")
  patch("/admin/sondes/:id", "monitors#update")
  delete("/admin/sondes/:id", "monitors#destroy")
  post("/admin/sondes/:id/verifier", "monitors#check_now", name: "check_monitor")

  get("/admin/pages", "pages#index", name: "pages")
  get("/admin/pages/nouvelle", "pages#new", name: "new_page")
  post("/admin/pages", "pages#create")
  get("/admin/pages/:id", "pages#edit", name: "page")
  patch("/admin/pages/:id", "pages#update")
  delete("/admin/pages/:id", "pages#destroy")
  post("/admin/pages/:id/composants", "components#create", name: "page_components")
  get("/admin/composants/:id", "components#edit", name: "component")
  patch("/admin/composants/:id", "components#update")
  delete("/admin/composants/:id", "components#destroy")

  get("/admin/incidents", "incidents#index", name: "incidents")
  get("/admin/incidents/nouveau", "incidents#new", name: "new_incident")
  post("/admin/incidents", "incidents#create")
  get("/admin/incidents/:id", "incidents#show", name: "incident")
  post("/admin/incidents/:id/suivis", "incidents#add_update", name: "incident_updates")
  delete("/admin/incidents/:id", "incidents#destroy")

  get("/admin/maintenances", "maintenances#index", name: "maintenances")
  get("/admin/maintenances/nouvelle", "maintenances#new", name: "new_maintenance")
  post("/admin/maintenances", "maintenances#create")
  get("/admin/maintenances/:id", "maintenances#edit", name: "maintenance")
  patch("/admin/maintenances/:id", "maintenances#update")
  delete("/admin/maintenances/:id", "maintenances#destroy")

  get("/admin/alertes", "alert_channels#index", name: "alert_channels")
  post("/admin/alertes", "alert_channels#create")
  delete("/admin/alertes/:id", "alert_channels#destroy")
  post("/admin/alertes/:id/test", "alert_channels#test", name: "test_alert_channel")
})
